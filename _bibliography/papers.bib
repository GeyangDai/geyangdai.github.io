@article{dai2026quantization,
  abbr        = {arXiv},
  title       = {Quantization Commutes with Reduction of Chern-Simons Gauge Theory},
  author      = {Dai, Geyang and Liang, Ruiming and Zhang, Yang},
  abstract    = {We prove an infinite-dimensional version of "quantization commutes with reduction" in the framework of geometric quantization of Chern-Simons gauge theory, focusing on the genus one case. The proof is complex-analytic and relies on the Atiyah-Bott stack and the Chern-Simons line bundle.},
  journal     = {arXiv preprint arXiv:2601.09666},
  year        = {2026},
  month       = {Jan},
  arxiv       = {2601.09666},
  doi         = {10.48550/arXiv.2601.09666},
  html        = {https://arxiv.org/abs/2601.09666},
  pdf         = {https://arxiv.org/pdf/2601.09666},
  selected    = {true}
}

@article{dai2026elliptic,
  abbr        = {arXiv},
  title       = {Elliptic Chern Characters and Elliptic Atiyah--Witten Formula},
  author      = {Dai, Geyang and Han, Fei},
  abstract    = {Let G be a compact, connected, and simply connected Lie group. A principal G-bundle over a manifold X, equipped with a connection, together with a positive-energy representation of the loop group LG, gives rise to a circle-equivariant gerbe module on the free loop space LX. From this data we construct the elliptic Chern character on LX, and a refinement, the elliptic Bismut--Chern character, on the double loop space L2X. Generalizing the classical Atiyah--Witten formula from the free loop space LX to the double loop space L2X, we establish an elliptic Atiyah--Witten formula.},
  journal     = {arXiv preprint arXiv:2601.18126},
  year        = {2026},
  month       = {Jan},
  arxiv       = {2601.18126},
  doi         = {10.48550/arXiv.2601.18126},
  html        = {https://arxiv.org/abs/2601.18126},
  pdf         = {https://arxiv.org/pdf/2601.18126},
  selected    = {true}
}
